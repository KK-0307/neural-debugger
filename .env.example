# Copy to .env for local development. Never commit real credentials.
POSTGRES_USER=neural_debugger
POSTGRES_PASSWORD=neural_debugger
POSTGRES_DB=neural_debugger

# Backend (prefix ND_)
ND_ENVIRONMENT=development
ND_LOG_LEVEL=INFO
ND_DATABASE_URL=postgresql+psycopg://neural_debugger:neural_debugger@localhost:5432/neural_debugger
ND_CORS_ORIGINS=["http://localhost:3000"]

# Frontend (baked into the browser bundle at build time; must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# RAG / LLM (Milestone 5). Credentials are read from the environment variable *named* below; never put a key in a file.
# ND_LLM_PROVIDER=anthropic            # none (default) | anthropic | openai_compatible | extractive (test only)
# ND_LLM_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=                   # set in your shell, not here
# ND_LLM_BASE_URL=http://localhost:11434/v1   # openai_compatible: e.g. a local Ollama/vLLM server (no key, no cost)
# ND_RETRIEVER_SYSTEM=hybrid-gte-tuned # or hybrid-custom-tiny (the from-scratch transformer), bm25

# Free hosted LLM: Google Gemini free tier via its OpenAI-compatible endpoint (no billing; see docs/rag.md "Free hosted LLM").
# Create the key in Google AI Studio inside a project WITHOUT billing, then put it in the git-ignored .env (not here):
#   GEMINI_API_KEY=...
# ND_LLM_PROVIDER=gemini
# ND_LLM_MODEL=gemini-3.1-flash-lite
# ND_LLM_MIN_INTERVAL_SECONDS=7      # stay under ~10 requests/minute
# ND_LLM_MAX_REQUESTS=45             # hard cap on requests sent per process

# Semantic grounding of citations (docs/semantic-grounding.md)
# ND_RAG_SEMANTIC_CHECK=rules         # off | rules (default, ~0.2 ms/claim) | nli (283 MB model, ~37 ms/claim)
# ND_RAG_DROP_DISPUTED=false          # true removes claims flagged only by NLI/negation signals

# Milestone 5.2 / 6
# ND_RAG_PROFILE=coverage              # coverage (default: model sees 7 sections, gate unchanged) | m5 (the Milestone 5 settings)
# ND_CORPUS_SUPPLEMENT_DIRS=["data/corpus_supplement"]   # extra official pages merged in memory over the frozen base corpus; [] = base only
# ND_EMBEDDING_DIR=data/embeddings_rag # embeddings of base + supplements (never overwrites data/embeddings/)
# ND_FEEDBACK_DIR=var/feedback         # append-only feedback.jsonl (git-ignored); the question is stored only on user opt-in

