# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Env / secrets (never commit)
.env
.env.*
!.env.example

# Local DBs and generated artifacts
*.db
data/raw/
data/processed/
checkpoints/
runs/
*.pt
*.pth

# Node
node_modules/
.next/
frontend/tsconfig.tsbuildinfo

# OS / editor
.DS_Store
.idea/
.vscode/

# Local assistant settings
.claude/settings.local.json

# Embeddings are regenerable; only the selected model's are committed (7.7 MB)
data/embeddings/*
!data/embeddings/gte-small/

# shipped model weights (small; see models/*/summary.json)
!models/**/*.pt

# user feedback written by the running backend (may contain opted-in question text)
var/
