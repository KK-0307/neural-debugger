{
 "name": "tiny-real",
 "seed": 0,
 "device": "auto",
 "out_dir": "runs",
 "model": {
  "hidden_dim": 64,
  "n_heads": 2,
  "n_layers": 1,
  "ffn_dim": 256,
  "max_seq_len": 256,
  "out_dim": 64,
  "dropout": 0.1,
  "pooling": "mean",
  "shared_towers": true
 },
 "data": {
  "vocab_size": 8000,
  "ict_per_chunk": 8,
  "keep_prob": 0.1,
  "heading": true,
  "errors": true,
  "holdout_fraction": 0.05,
  "leakage_threshold": 0.6,
  "max_query_len": 64,
  "max_doc_len": 256,
  "regime": "synthetic+real",
  "real_repeat": 3
 },
 "negatives": {
  "strategy": "in_batch",
  "n_hard": 1,
  "pool_top": 30,
  "skip_top": 0
 },
 "augment": {
  "query_token_dropout": 0.2,
  "doc_token_dropout": 0.1
 },
 "optim": {
  "lr": 0.0005,
  "weight_decay": 0.01,
  "warmup_frac": 0.05,
  "epochs": 12,
  "batch_size": 128,
  "grad_clip": 1.0,
  "temperature": 0.05,
  "min_lr_frac": 0.1,
  "symmetric_loss": true
 },
 "stop": {
  "patience": 3,
  "min_delta": 0.002
 }
}